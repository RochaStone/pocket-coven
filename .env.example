# Public (shipped to the browser). From Supabase: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Absolute site URL used to build invite and magic-link redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server/CLI only. NEVER prefix with NEXT_PUBLIC_, never commit, never set in client code.
# Used only by scripts/create-invite.mjs to mint the first (owner) invite.
SUPABASE_SERVICE_ROLE_KEY=

# Tests only: a throwaway local Postgres the DB test suite may drop and recreate.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pocket_coven_test
